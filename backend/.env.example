# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# Vision AI Provider (Options: mock, gemini, openai)
VISION_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Search Provider (Options: mock, brave, serpapi)
SEARCH_PROVIDER=mock
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Search Engine Strategy Settings
SEARCH_MODE=marketplace
MAX_QUERIES=4
MAX_RESULTS_PER_QUERY=5
MAX_MARKETPLACES=3
