{
  "manifest_version": 3,
  "name": "Pinterest → Amazon Visual Product Finder",
  "version": "1.0.0",
  "description": "Select any product from a Pinterest image and instantly find matching items on Amazon.in.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.pinterest.com/*",
    "*://*.pinterest.in/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Pinterest Product Finder"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.in/*"
      ],
      "js": [
        "content/pinterest.js"
      ],
      "css": [
        "assets/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.in/*"
      ]
    }
  ]
}
